# Puerto del servidor
PORT=3004

# Secreto para verificar tokens JWT (debe ser el mismo que auth-service)
JWT_SECRET=dev-secret-no-usar-en-produccion

# Ruta al archivo de base de datos SQLite
DB_PATH=./data/notifications.db

# URLs de microservicios relacionados
BUDGETS_SERVICE_URL=http://localhost:3003
TRANSACTIONS_SERVICE_URL=http://localhost:3002
